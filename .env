# ---------- PostgreSQL ----------
POSTGRES_DB=citas
POSTGRES_USER=citas_user
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_PORT=5432

# ---------- Backend (Spring Boot) ----------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Zona horaria de la clinica (los horarios se calculan en esta zona)
CLINICA_ZONA_HORARIA=America/Guayaquil

# ---------- Correo (en desarrollo lo captura Mailpit) ----------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_REMITENTE=citas@clinica.test
MAILPIT_UI_PORT=8025

# ---------- SMS (proveedor externo) ----------
SMS_API_URL=http://sms-proveedor:9100
SMS_API_KEY=clave_de_ejemplo

# ---------- Reglas de negocio ----------
# Cancelacion del paciente: horas minimas de anticipacion
CANCELACION_MIN_HORAS=2
# Recordatorios: horas antes de la cita
RECORDATORIO_HORAS=24,2
# Reintentos: minutos de espera entre intentos y maximo de intentos
RECORDATORIO_ESPERAS_MIN=5,15,60
RECORDATORIO_MAX_INTENTOS=4
# Cada cuanto revisa el worker los recordatorios pendientes (cron de Spring)
RECORDATORIO_CRON=0 * * * * *
